---
import { content, type Lang } from '../i18n/content';
import narration from '../data/opening-narration.json';
interface Props { lang: Lang; media?: boolean }
const { lang, media = false } = Astro.props;
const c = content[lang];
const video = `/media/the-line-on-the-mountain-${lang}.mp4`;
---
<section class="section opening-section" id="story" aria-labelledby="opening-title">
  <div class="container">
    <div class="section-heading split-heading">
      <div><p class="eyebrow">{media ? c.openingTag : c.openingLabel}</p><h2 id="opening-title">{c.openingTitle}</h2><p class="lede">{c.openingBody}</p></div>
      <p class="small-note">{c.openingNote}</p>
    </div>
    <figure class="film opening-film">
      <div class="opening-player" data-opening-player>
        <video id="opening-video" controls playsinline preload="none" poster={`/media/opening-poster-${lang}.webp`} width="1280" height="720" aria-label={c.openingTitle} aria-describedby="opening-description">
          <source src={video} type="video/mp4" />
          <track kind="captions" src={`/media/the-line-on-the-mountain-${lang}.vtt`} srclang={lang} label={lang === 'th' ? 'ไทย' : 'English'} />
          <a href={video}>{c.openingDownload}</a>
        </video>
        <button class="opening-play" type="button" aria-controls="opening-video" hidden><span aria-hidden="true">▶</span>{c.openingPlay}</button>
      </div>
      <figcaption id="opening-description"><span class="film-tag">{c.openingTag}</span><span>{c.openingCaption}</span><span>01:07</span></figcaption>
    </figure>
    <div class="opening-footer"><p class="small-note">{c.openingLanguage}</p><a class="text-link" href={video} download>{c.openingDownload} <span aria-hidden="true">↓</span></a></div>
    <p class="opening-error small-note" role="alert" hidden>{c.openingError}</p>
    <details class="opening-transcript"><summary>{c.openingTranscript}<span aria-hidden="true">+</span></summary><div>{narration.map(cue => <p>{cue[lang]}</p>)}</div></details>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-opening-player]').forEach((stage) => {
    const video = stage.querySelector<HTMLVideoElement>('video');
    const button = stage.querySelector<HTMLButtonElement>('.opening-play');
    const error = stage.closest('section')?.querySelector<HTMLElement>('.opening-error');
    if (!video || !button) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try { await video.play(); }
      catch { if (error) error.hidden = false; }
    });
    video.addEventListener('play', () => {
      button.hidden = true;
      if (error) error.hidden = true;
    });
    video.addEventListener('ended', () => { button.hidden = false; });
    video.addEventListener('error', () => { if (error) error.hidden = false; });
  });
  // Switching between the story and gameplay must not stack two soundtracks.
  const videos = document.querySelectorAll<HTMLVideoElement>('video');
  videos.forEach(video => video.addEventListener('play', () => {
    videos.forEach(other => { if (other !== video) other.pause(); });
  }));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) videos.forEach(video => video.pause());
  });
</script>
