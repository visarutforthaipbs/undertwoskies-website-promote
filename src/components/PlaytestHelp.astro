---
import { type Lang } from '../i18n/content';
interface Props {lang:Lang}
const {lang}=Astro.props;
const en=lang==='en';
const template=en ? 'Build: beta 3 (0.3.0)\nComputer / OS:\nGame language (Thai / English):\nWhat I was doing:\nWhat happened:\nWhat I expected:\nScreenshot / playtest_log.csv (if available):' : 'บิลด์: เบตา 3 (0.3.0)\nคอมพิวเตอร์ / ระบบปฏิบัติการ:\nภาษาในเกม (ไทย / อังกฤษ):\nกำลังทำอะไรอยู่:\nสิ่งที่เกิดขึ้น:\nสิ่งที่คาดว่าจะเกิด:\nภาพหน้าจอ / playtest_log.csv (ถ้ามี):';
const languageNote=en ? 'Game: Thai / English text, subtitles and recorded speech. Choose in Settings; the default is Thai. Linux / Steam Deck builds are untested.' : 'ตัวเกม: ข้อความ คำบรรยาย และเสียงพูดไทย / อังกฤษ เลือกได้ในตั้งค่า เริ่มต้นเป็นภาษาไทย บิลด์ Linux / Steam Deck ยังไม่ผ่านการทดสอบ';
---
<aside class="playtest-help" aria-label={en?'Playtest help':'ช่วยส่งความคิดเห็น'}>
<p class="small-note" data-device-note data-mobile={en?'On a phone or tablet? You can explore this website, but the game needs a Windows, macOS or Linux computer.':'เปิดจากมือถือหรือแท็บเล็ต? อ่านและดูภาพบนเว็บได้ แต่ตัวเกมต้องเล่นบนคอมพิวเตอร์ Windows, macOS หรือ Linux'} data-default={languageNote}>{languageNote}</p>
<details class="feedback-template"><summary>{en?'Send feedback — a short template':'ส่งความคิดเห็น — แบบฟอร์มสั้น ๆ'}</summary>
<p class="small-note">{en?'Copy, fill in what you know, and post in Discord #feedback. Attach a screenshot or playtest_log.csv if available.':'คัดลอก เติมข้อมูลที่ทราบ แล้วส่งใน Discord ช่อง #feedback แนบภาพหน้าจอหรือ playtest_log.csv ถ้ามี'}</p>
<textarea readonly aria-label={en?'Feedback template':'แบบฟอร์มความคิดเห็น'} rows="7">{template}</textarea>
<button type="button" class="header-cta" data-copy-feedback data-success={en?'Copied — paste it in Discord.':'คัดลอกแล้ว — วางใน Discord ได้เลย'} data-fallback={en?'Select the text above and copy it manually.':'เลือกข้อความด้านบนแล้วคัดลอกได้เลย'}>{en?'Copy template':'คัดลอกแบบฟอร์ม'}</button>
<span class="small-note" role="status" aria-live="polite" data-copy-status></span>
<p><a class="text-link" href="https://discord.gg/ZJ2ywpJ7Ss">{en?'Open Discord #feedback':'เปิด Discord เพื่อส่งความคิดเห็น'} ↗</a></p>
</details></aside>
